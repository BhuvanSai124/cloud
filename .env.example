# CloudPulse Environment Variables

# Data source mode
DATA_SOURCE=simulated

# GCP Project ID (required for GCP mode; do not commit real project IDs)
GCP_PROJECT_ID=

# Collection interval in seconds (1-minute is a demo option, not automatic requirement)
COLLECTION_INTERVAL_SECONDS=60

# Notification cooldown in minutes (demo default: 10 minutes)
NOTIFICATION_COOLDOWN_MINUTES=10

# Recovery readings count (demo default: 3 consecutive healthy readings)
RECOVERY_READINGS_COUNT=3

# Frontend origin for CORS (must match frontend dev server URL)
FRONTEND_ORIGIN=http://localhost:5173

# Demo threshold defaults (configurable, NOT universal production advice)
# CPU thresholds
DEMO_CPU_WARNING=80
DEMO_CRITICAL=90

# Memory thresholds
DEMO_MEMORY_WARNING=80
DEMO_MEMORY_CRITICAL=90

# Application settings